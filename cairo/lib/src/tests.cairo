    #[test]
    fn rsw_keystream_roundtrip() {
        let y = array![3408756805384303870, 14618296925498912173, 150365932498102674, 15861079474072389789, 604491081150401257, 814217202578535843, 15852348834453180919, 4844336750743033684].span();
        let key = derive_key(0x3171a7acd1b295090fe561a0347d9a20e6ebe5490c44d34731f5102c211aeab, y);
        let pt = array![0x1312d0, 0x9af3bce5cec51ae84834a579a56f1b2a431ae7fbfcedd8b5161b65fb94d414, 0x626964].span();
        let ct = array![0x32d8e3aabd4275fb0269a951ab6a64deb4a2ad27817a5b2df158b0cfe94baba, 0x16a3e4a92b16e4278060c08c93bcf047f54fb233fa0e375c4bd60942100f256, 0x7bd8351f483b9b056bf1ff6fbb67483a02b086021c0fd6176cd5bf37fd7779b].span();
        let got = decrypt(key, ct);
        assert(got.span() == pt, 'decrypt');
        assert(encrypt(key, pt).span() == ct, 'encrypt');
        assert(core::poseidon::poseidon_hash_span(ct) == 0x484c85eff7ce52fc6e280e023c4697e876ddcbfaef32491aff96836ed67d53a, 'ct hash');
        assert(core::poseidon::poseidon_hash_span(pt) == 0x2e2e0a8f453d06a2b4cdbd9c37fe5b8b81847c1771171b6cea76f040386873d, 'pt hash');
